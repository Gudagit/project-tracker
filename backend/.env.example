# PostgreSQL connection string (e.g. from Neon, Supabase or a local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional: comma-separated list of allowed frontend origins (leave empty for local dev)
# CORS_ORIGIN="https://your-frontend.example.com"

# Optional: port (defaults to 3000)
# PORT=3000
